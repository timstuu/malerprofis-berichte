# Supabase-Zugangsdaten.
# Lokal als .env.local anlegen; für das Deployment als GitHub-Repository-Secrets
# hinterlegen (Settings → Secrets and variables → Actions).
#
# Beide Werte stehen im Supabase-Projekt unter Project Settings → API.
# Der anon key ist für den Browser bestimmt und darf öffentlich sein — der
# Schutz der Daten liegt vollständig in den RLS-Policies der Datenbank.

VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
